---
// Brand marks that Lucide does not ship.
//
// Lucide removed its brand icons on purpose: logos are trademarked and its
// versions were drawn inconsistently. So the platforms that matter most on a
// link page get their official mark inlined here, taken from Simple Icons
// (CC0-1.0, the upstream source of these paths).
//
// Source: https://simpleicons.org · https://github.com/simple-icons/simple-icons
//
// These are .astro components, not @lucide/astro icons, so they are NOT listed
// in src/lib/icon-names.ts. They take the same `size` prop the rows pass to
// Lucide icons, and fill with currentColor so row hover and the light theme
// both tint them correctly.

export interface Props {
	size?: number;
	class?: string;
}

const { size = 17, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="currentColor"
	aria-hidden="true"
>
