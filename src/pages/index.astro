---
import Layout from '../layouts/Layout.astro';
import { GROUP_ORDER, LINKS, type LinkItem } from '../data/links';
import { getIcon } from '../lib/icons';

const visible = LINKS.filter((l) => l.visible);

// One section only. The page has a single list, so a link does not need a
// group: anything without an explicit group belongs to 'socials'. Adding a
// second section later is a data change (GROUP_ORDER), not a template change.
const SECTION = GROUP_ORDER[0];
const groups: { heading: string; items: LinkItem[] }[] = [];
for (const heading of GROUP_ORDER) {
	const items = visible
		.filter((l) => (l.group ?? SECTION) === heading)
		.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false));
	if (items.length > 0) groups.push({ heading, items });
}
// Anything pointed at a heading that is not in GROUP_ORDER still shows up,
// at the end. The test suite rejects this so it cannot silently become real.
const known = new Set<string>(GROUP_ORDER);
const stray = visible.filter((l) => l.group && !known.has(l.group));
if (stray.length > 0) groups.push({ heading: 'else', items: stray });

const count = visible.length;

/** Short host label for the right-hand column, e.g. 'infosec.exchange'. */
function hostOf(href: string): string {
	try {
		return new URL(href).hostname.replace(/^www\./, '');
	} catch {
		return 'local';
	}
}
---

<Layout title="oem/links">
	<section class="hero">
		<p class="cm-kicker">one page to rule the links</p>
		<h1 class="hero-title">$ oem/links</h1>
		<p class="hero-desc">
			Everywhere to find me. No tracking, no runtime, nothing to sign up for.
		</p>
	</section>

	<section class="status">
		<span class="lbl">status</span>
		<span class="val">● static build · links.oem.ngo · {count} link{count === 1 ? '' : 's'}</span>
	</section>

	{
		groups.map((group) => (
			<section class="links">
				<div class="list-head">{group.heading}</div>
				<ul class="link-list">
					{group.items.map((link) => {
						const Icon = getIcon(link.icon);
						const isEmail = link.kind === 'email';
						return (
							<li>
								<a
									class="link-row"
									href={link.href}
									target={isEmail ? undefined : '_blank'}
									rel={isEmail ? undefined : 'noopener'}
								>
									<span class="link-idx" aria-hidden="true">
										{String(visible.indexOf(link) + 1).padStart(2, '0')}
									</span>
									<span class="link-icon">
										{Icon ? <Icon size={17} aria-hidden="true" /> : null}
									</span>
									<span class="link-body">
										<span class="link-title">{link.title}</span>
										<span class="link-desc">{link.description}</span>
									</span>
									<span class="link-host" aria-hidden="true">
										{isEmail ? 'email' : hostOf(link.href)}
									</span>
									<span class="link-sym" aria-hidden="true">▸</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		))
	}
</Layout>

<style>
	.hero { padding: 0.5rem 0 2.2rem; }
	/* The element carries the library's .cm-kicker, not a bare .kicker. This
	   selector was not renamed during the oem-ui migration, so the 1rem gap
	   silently became 0 and the eyebrow welded itself to the title. */
	.hero .cm-kicker { margin-bottom: 1rem; }
	.hero-title {
		font-size: 2.2rem;
		letter-spacing: -0.01em;
		line-height: 1.1;
		margin-bottom: 1.3rem;
	}
	.hero-desc {
		color: var(--ink-dim);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 0;
		max-width: 62ch;
	}

	.status {
		padding: 0.8rem 1.1rem;
		background: var(--panel);
		border: 1px solid var(--line);
		margin-bottom: 2.2rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-dim);
	}
	.status .lbl {
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.66rem;
		margin-right: 0.7rem;
	}
	.status .val { color: var(--ink); }

	.links { margin-top: 2.2rem; }
	.links + .links { margin-top: 2.2rem; }
	.list-head {
		font-size: 0.7rem;
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.6rem;
		margin-bottom: 0.2rem;
	}

	.link-list { list-style: none; margin: 0; padding: 0; }
	.link-list li { margin: 0; }

	.link-row {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 0.85rem 0.5rem;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: background 0.1s ease;
	}
	.link-row:hover { background: var(--panel); }
	.link-row:focus-visible {
		background: var(--panel);
		outline: 1px solid var(--ink-dim);
		outline-offset: -1px;
	}

	.link-idx {
		color: var(--ink-faint);
		font-size: 0.75rem;
		min-width: 1.6rem;
		flex-shrink: 0;
	}
	.link-icon {
		color: var(--ink-dim);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.1rem;
	}
	.link-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.link-title {
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.link-desc {
		color: var(--ink-faint);
		font-size: 0.8rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.link-host {
		color: var(--ink-faint);
		font-size: 0.72rem;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.link-sym {
		color: var(--ink-faint);
		transition: color 0.12s ease;
		flex-shrink: 0;
	}
	.link-row:hover .link-sym { color: var(--ink); }
	.link-row:hover .link-host { color: var(--ink-dim); }

	@media (max-width: 680px) {
		.hero { padding: 1rem 0 1.8rem; }
		.hero-title { font-size: 1.9rem; }
		.link-desc, .link-host { display: none; }
	}

	/* ---- phone type floor ----
	   cli-mono floors its own components at --min-font on a coarse
	   pointer. These four are declared here, in Astro's scoped block,
	   so they never see that rule and rendered at 10.56-11.52px on a
	   phone. The floor has to live beside the declarations it
	   overrides: Astro rewrites the descendant rules below to
	   `.status[data-astro-cid-x] .lbl[data-astro-cid-x]` at (0,4,0),
	   and nothing readable from an imported stylesheet can match that
	   without a contrived selector. Keep the next rule last so it wins
	   the tie. */
	@media (pointer: coarse) {
		.status,
		.status .lbl,
		.status .val,
		.status .ok,
		.status .bar,
		.list-head,
		.link-host,
		.link-idx,
		.link-desc {
			font-size: max(var(--min-font), 0.66rem);
		}
	}
</style>
