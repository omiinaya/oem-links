---
import Layout from '../layouts/Layout.astro';
import { AUTHOR_EMAIL, AUTHOR_HANDLE } from '../consts';
import { GROUP_ORDER, LINKS, type LinkItem } from '../data/links';
import { getIcon } from '../lib/icons';

const visible = LINKS.filter((l) => l.visible);

// Same links in the same order, bucketed by their group heading.
const groups: { heading: string; items: LinkItem[] }[] = [];
for (const heading of GROUP_ORDER) {
	const items = visible
		.filter((l) => l.group === heading)
		.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false));
	if (items.length > 0) groups.push({ heading, items });
}
// Anything not named in GROUP_ORDER still shows up, at the end.
const stray = visible.filter((l) => !l.group || !(GROUP_ORDER as readonly string[]).includes(l.group));
if (stray.length > 0) groups.push({ heading: 'else', items: stray });

const count = visible.length;

/** Short host label for the right-hand column, e.g. 'mrxlab.net'. */
function hostOf(href: string): string {
	if (href.startsWith('mailto:')) return '@';
	try {
		return new URL(href).hostname.replace(/^www\./, '');
	} catch {
		return 'local';
	}
}
---

<Layout title="oem/links">
	<section class="hero">
		<p class="kicker">one page to rule the links</p>
		<h1 class="hero-title">$ oem/links</h1>
		<p class="hero-desc">
			Everything worth pointing at, in one place. Same CLI-mono house style as
			the blog: no tracking, no runtime, nothing to sign up for.
		</p>
	</section>

	<section class="status">
		<span class="lbl">status</span>
		<span class="val">● static build · self-hosted · {count} link{count === 1 ? '' : 's'}</span>
	</section>

	{
		groups.map((group) => (
			<section class="links">
				<div class="list-head">{group.heading}</div>
				<ul class="link-list">
					{group.items.map((link) => {
						const Icon = getIcon(link.icon);
						return (
							<li>
								<a
									class="link-row"
									href={link.href}
									target={link.kind === 'external' || link.kind === 'internal' ? '_blank' : undefined}
									rel={link.kind === 'external' ? 'noopener' : link.kind === 'internal' ? 'me' : undefined}
								>
									<span class="link-idx" aria-hidden="true">
										{String(visible.indexOf(link) + 1).padStart(2, '0')}
									</span>
									<span class="link-icon">
										{Icon ? <Icon size={17} aria-hidden="true" /> : null}
									</span>
									<span class="link-body">
										<span class="link-title">{link.title}</span>
										<span class="link-desc">{link.description}</span>
									</span>
									<span class="link-host" aria-hidden="true">
										{link.kind === 'email' ? '@' : hostOf(link.href)}
									</span>
									<span class="link-sym" aria-hidden="true">▸</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		))
	}

	<section class="foot">
		<div class="foot-row">
			<span class="foot-k">found a dead link, or something to add?</span>
			<a class="foot-a" href={`mailto:${AUTHOR_EMAIL}`}>mail {AUTHOR_HANDLE} →</a>
		</div>
		<div class="foot-row">
			<span class="foot-k">source</span>
			<a class="foot-a" href="https://github.com/omiinaya" target="_blank" rel="me">github.com/omiinaya →</a>
		</div>
	</section>
</Layout>

<style>
	.hero { padding: 0.5rem 0 2.2rem; }
	.hero .kicker { margin-bottom: 1rem; }
	.hero-title {
		font-size: 2.2rem;
		letter-spacing: -0.01em;
		line-height: 1.1;
		margin-bottom: 1.3rem;
	}
	.hero-desc {
		color: var(--ink-dim);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 0;
		max-width: 62ch;
	}

	.status {
		padding: 0.8rem 1.1rem;
		background: var(--panel);
		border: 1px solid var(--line);
		margin-bottom: 2.2rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-dim);
	}
	.status .lbl {
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.66rem;
		margin-right: 0.7rem;
	}
	.status .val { color: var(--ink); }

	.links { margin-top: 2.2rem; }
	.links + .links { margin-top: 2.2rem; }
	.list-head {
		font-size: 0.7rem;
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.6rem;
		margin-bottom: 0.2rem;
	}

	.link-list { list-style: none; margin: 0; padding: 0; }
	.link-list li { margin: 0; }

	.link-row {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 0.85rem 0.5rem;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: background 0.1s ease;
	}
	.link-row:hover { background: var(--panel); }
	.link-row:focus-visible {
		background: var(--panel);
		outline: 1px solid var(--ink-dim);
		outline-offset: -1px;
	}

	.link-idx {
		color: var(--ink-faint);
		font-size: 0.75rem;
		min-width: 1.6rem;
		flex-shrink: 0;
	}
	.link-icon {
		color: var(--ink-dim);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.1rem;
	}
	.link-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.link-title {
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.link-desc {
		color: var(--ink-faint);
		font-size: 0.8rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.link-host {
		color: var(--ink-faint);
		font-size: 0.72rem;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.link-sym {
		color: var(--ink-faint);
		transition: color 0.12s ease;
		flex-shrink: 0;
	}
	.link-row:hover .link-sym { color: var(--ink); }
	.link-row:hover .link-host { color: var(--ink-dim); }

	.foot {
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.foot-row {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: baseline;
		column-gap: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	.foot-k { color: var(--ink-faint); }
	.foot-a {
		color: var(--ink-dim);
		text-decoration: none;
		text-align: right;
	}
	.foot-a:hover { color: var(--ink); }

	@media (max-width: 680px) {
		.hero { padding: 1rem 0 1.8rem; }
		.hero-title { font-size: 1.9rem; }
		.link-desc, .link-host { display: none; }
		.foot-row { grid-template-columns: 1fr; row-gap: 0.1rem; }
		.foot-a { text-align: left; }
	}
</style>
