---
import Layout from '../layouts/Layout.astro';
import { GROUP_ORDER, LINKS, type LinkItem } from '../data/links';
import { getIcon } from '../lib/icons';

const visible = LINKS.filter((l) => l.visible);

// One section only. The page has a single list, so a link does not need a
// group: anything without an explicit group belongs to 'socials'. Adding a
// second section later is a data change (GROUP_ORDER), not a template change.
const SECTION = GROUP_ORDER[0];
const groups: { heading: string; items: LinkItem[] }[] = [];
for (const heading of GROUP_ORDER) {
	const items = visible
		.filter((l) => (l.group ?? SECTION) === heading)
		.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false));
	if (items.length > 0) groups.push({ heading, items });
}
// Anything pointed at a heading that is not in GROUP_ORDER still shows up,
// at the end. The test suite rejects this so it cannot silently become real.
const known = new Set<string>(GROUP_ORDER);
const stray = visible.filter((l) => l.group && !known.has(l.group));
if (stray.length > 0) groups.push({ heading: 'else', items: stray });

const count = visible.length;

/** Short host label for the right-hand column, e.g. 'infosec.exchange'. */
function hostOf(href: string): string {
	try {
		return new URL(href).hostname.replace(/^www\./, '');
	} catch {
		return 'local';
	}
}
---

<Layout title="oem/links">
	<section class="cm-head">
		<p class="cm-kicker">one page to rule the links</p>
		<h1 >$ oem/links</h1>
		<p class="cm-head__sub">
			Everywhere to find me. No tracking, no runtime, nothing to sign up for.
		</p>
	</section>

	<section class="cm-status">
		<span class="cm-status__label">status</span>
		<span class="cm-status__value">● static build · links.oem.ngo · {count} link{count === 1 ? '' : 's'}</span>
	</section>

	{
		groups.map((group) => (
			<section class="links">
				<div class="cm-list-head">{group.heading}</div>
				<ul class="cm-rows cm-rows--column">
					{group.items.map((link) => {
						const Icon = getIcon(link.icon);
						const isEmail = link.kind === 'email';
						return (
							<li>
								<a
									class="cm-row"
									href={link.href}
									target={isEmail ? undefined : '_blank'}
									rel={isEmail ? undefined : 'noopener'}
								>
									<span class="cm-row__idx" aria-hidden="true">
										{String(visible.indexOf(link) + 1).padStart(2, '0')}
									</span>
									<span class="cm-row__icon">
										{Icon ? <Icon size={17} aria-hidden="true" /> : null}
									</span>
									<span class="cm-row__body">
										<span class="cm-row__title">{link.title}</span>
										<span class="cm-row__desc">{link.description}</span>
									</span>
									<span class="cm-row__meta" aria-hidden="true">
										{isEmail ? 'email' : hostOf(link.href)}
									</span>
									<span class="cm-row__sym" aria-hidden="true">▸</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		))
	}
</Layout>

<style>
	/* Everything on this page is oem-ui surface: .cm-head, .cm-status,
	   .cm-list-head, .cm-rows, .cm-row and its parts. The rules below are
	   only what the library deliberately does not own.

	   Group separation is the stack's job: `<main>` is a
	   `cm-stack cm-stack--section`, so these sections get the same
	   24px rhythm as every other top-level block. A page-local
	   `margin-top` here would stack on top of that gap and make this
	   one page the only one reading as 56px.

	   `.links` stays as the section wrapper so the markup reads as a
	   group, but it owns no spacing of its own any more. */
	.links {
		/* spacing comes from the parent stack */
	}

	/* A link hub's title is the page's whole point, so it is set larger
	   than the library's default head size. */
	.cm-head h1 {
		font-size: 2.2rem;
		letter-spacing: -0.01em;
		line-height: 1.1;
		margin-bottom: var(--space-5);
	}

	@media (max-width: 680px) {
		.cm-head h1 {
			font-size: 1.9rem;
		}
		/* Pre-existing behaviour, unchanged by the migration: on a phone
		   the row keeps index, icon, title and arrow, and drops the two
		   quiet slots. They stay in the markup, just not rendered. */
		.cm-row__desc,
		.cm-row__meta {
			display: none;
		}
	}
</style>
