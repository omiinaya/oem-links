---
/**
 * The library's <Footer>, not a parallel implementation.
 *
 * This file used to be 69 lines carrying its own `<footer>`, its own
 * scoped CSS and — the part that mattered — its own separator ELEMENTS
 * (`<span class="dot">·</span>`) inside a `flex-wrap: wrap` row. That is
 * exactly the shape oem-ui deleted: a separator that is its own flex item
 * can be the last thing on a wrapped line with nothing after it.
 *
 * MEASURED in WebKit against the LIVE site (before this change) at
 * 320/360/390/402/430 x {667,844}: a line ended with a stranded `·` at
 * 10 of 12 phone widths, and at 320x667 the footer rendered three lines
 * for three fragments. The library's separator is generated by the item
 * it PRECEDES, so no line can end with one.
 *
 * The site-specific content is unchanged — same fragments, same status
 * line — it just comes from props and the shared component now.
 */
import Footer from '../astro/Footer.astro';
import { SITE } from '../astro/config';
---

<Footer
	items={['build with astro', 'static', 'no tracking']}
	contactHref={`mailto:${SITE.email}`}
	status="all systems nominal · zero trackers · zero cookies"
/>