---
// The design system is cli-mono (src/styles/cli-mono/), installed from
// /root/projects/oem-ui via scripts/install.sh. This project's own
// overrides live in site.css, loaded last so it wins on equal specificity.
import '../styles/cli-mono/tokens.css';
import '../styles/cli-mono/base.css';
import '../styles/cli-mono/components.css';
import '../styles/site.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
// The FOUC guard, from the library. Imported with ?raw and inlined, so it
// runs before any stylesheet. It used to be a hand-rolled copy in
// src/lib/cm-theme.ts that took the key list as a build-time argument -
// which is the bug the library fixed: a key list assembled at build time
// cannot see a theme saved under a LEGACY key, because the guard is
// evaluated before the runtime bundle exists, so every returning light-theme
// visitor got a black flash. One shared file removes the second copy.
import themeGuard from '../js/cli-mono-theme-guard.js?raw';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;
---

<!-- Global Metadata -->
<!-- prevent flash-of-wrong-theme (must precede every stylesheet) -->
<script is:inline set:html={themeGuard} />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
<!-- No sitemap link: this site is a single static page and generates none.
     The blog's sitemap/RSS <link>s were removed with the rest of the cross-refs. -->
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
